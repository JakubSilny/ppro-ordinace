DB_NAME=ordinace
DB_USER=ordinace
DB_PASSWORD=zmente-heslo-databaze
# účty recepce a lékařů: jmeno:heslo oddělené čárkou; v produkci dlouhá unikátní hesla
APP_USERS=recepce:zmente-toto-heslo,spravce:zmente-heslo-spravce
# správci (Super Admin): navíc vidí celý záznam přístupů; jména musí být v APP_USERS
APP_ADMINS=spravce
# za HTTPS proxy nastavte true
COOKIE_SECURE=false
# demo = ukázkoví pacienti, termíny a návštěvy pro předvedení; v ostrém provozu smazat
SPRING_PROFILES_ACTIVE=demo
